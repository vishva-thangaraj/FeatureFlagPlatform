# The dashboard (the feature-platform-ui repository), served on its own hostname by the same nginx
# that fronts the API. Rendered like prod.conf.template: ${UI_DOMAIN} is substituted at container
# start and nothing else, because NGINX_ENVSUBST_FILTER in the compose file names only the two
# domain variables.
#
# SAME ORIGIN ON PURPOSE
# The UI calls the API at window.location.origin, so /api/ is proxied here straight to the app on
# the Docker network instead of the browser calling the API hostname cross-origin. That is what the
# backend was built for: the refresh cookie (SameSite=Strict, Path=/api/v1/auth, host-only) works
# unchanged, no CORS configuration is needed, and the rate limiter still sees exactly one appending
# proxy, so RATE_LIMIT_PROXY_HOPS stays 1.
#
# NO PORT 80 BLOCK
# The HTTP server in prod.conf.template is nginx's default server for port 80, so it already
# answers this hostname's ACME challenge and redirects everything else to https://$host. That is
# also why the first certificate can be issued in webroot mode with nginx running
# (deploy/tls-add-domain.sh).
#
# RELEASES
# deploy/deploy-ui.sh unpacks each build into /opt/platform/ui/releases/<sha> and points the
# relative symlink /opt/platform/ui/current at it. That directory is mounted at /srv/ui, so
# switching releases is one atomic rename and needs no nginx reload.

server {
    listen 443 ssl;
    http2 on;
    server_name ${UI_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${UI_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${UI_DOMAIN}/privkey.pem;

    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    # The same zone the API server declares; nginx shares a named zone between servers.
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    root /srv/ui/current;

    # Every location below inherits these only because none of them uses add_header: one that did
    # would silently drop all of them (nginx does not merge add_header across levels). Cache
    # lifetimes are therefore set with `expires`, which is a different directive.
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options    "nosniff" always;
    add_header X-Frame-Options           "DENY" always;
    add_header Referrer-Policy           "strict-origin-when-cross-origin" always;
    # The build has no inline script and loads nothing from another origin. 'unsafe-inline' for
    # styles is for the style attributes Radix sets and the <style> element sonner injects.
    add_header Content-Security-Policy   "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;

    # The API, same origin. Kept identical to the /api/ location in prod.conf.template.
    location /api/ {
        proxy_pass http://app:8080;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 30s;
        proxy_read_timeout    60s;
        proxy_send_timeout    60s;
    }

    # Vite content-hashes everything it emits here, so a changed file always gets a new name and
    # these can be cached for a year. No SPA fallback: a missing asset must be a 404, not
    # index.html served as JavaScript.
    location /assets/ {
        expires 1y;
    }

    # Client-side routes (/t/<id>/flags, /invitations/accept, ...) all fall back to index.html,
    # which React Router then resolves. `expires epoch` sends Cache-Control: no-cache, so a browser
    # revalidates index.html on every load and picks up a new release's asset names immediately.
    location / {
        try_files $uri /index.html;
        expires epoch;
    }
}

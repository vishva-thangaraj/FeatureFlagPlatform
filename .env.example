How to s# External Oracle Database connection
# For OCI Autonomous DB Free:
#   SPRING_DATASOURCE_URL=jdbc:oracle:thin:@featureflagdb_low?TNS_ADMIN=/path/to/wallet
# For OCI Oracle DB on Compute VM:
#   SPRING_DATASOURCE_URL=jdbc:oracle:thin:@<host-ip>:1521/FREEPDB1
# For local Oracle install:
#   SPRING_DATASOURCE_URL=jdbc:oracle:thin:@localhost:1521/FREEPDB1

SPRING_DATASOURCE_URL=jdbc:oracle:thin:@localhost:1521/FREEPDB1
SPRING_DATASOURCE_USERNAME=featureflag
SPRING_DATASOURCE_PASSWORD=featureflag
SERVER_PORT=8080

# --- Kafka (feature-change events) ---
# Defaults suit `docker compose -f docker-compose.yml -f docker-compose.dev.yml up`:
# the broker's host listener is localhost:9092, the registry localhost:8081. Inside the
# app container (docker profile) they are kafka:29092 / http://schema-registry:8081.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SCHEMA_REGISTRY_URL=http://localhost:8081
# Topic shape — see docs/feature-events.md. RF 1 locally (single broker).
KAFKA_TOPIC_PARTITIONS=6
KAFKA_TOPIC_REPLICAS=1
# Set false if you provision feature.flag.changes.v1 yourself.
KAFKA_TOPIC_AUTO_PROVISION=true

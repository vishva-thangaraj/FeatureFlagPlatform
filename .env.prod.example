# =============================================================================
# Production Environment Variables
# Copy this file to .env on the OCI VM at /opt/platform/.env
# Fill in all values — never commit the real .env to git!
# =============================================================================

# --- OCI Autonomous Database ---
# Connection string format for Autonomous DB:
#   jdbc:oracle:thin:@<db-name>_low?TNS_ADMIN=/opt/oracle/wallet
# Download the wallet from OCI Console > Autonomous Database > DB Connection
SPRING_DATASOURCE_URL=jdbc:oracle:thin:@featureflagdb_low?TNS_ADMIN=/opt/oracle/wallet
SPRING_DATASOURCE_USERNAME=ADMIN
SPRING_DATASOURCE_PASSWORD=<your-autonomous-db-password>

# --- JWT ---
# Generate with: openssl rand -base64 32
JWT_SECRET=<base64-encoded-256-bit-secret>

# --- Email (SMTP) ---
# Use a real SMTP provider (e.g., Brevo, SendGrid, AWS SES, Gmail SMTP)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=<smtp-username>
MAIL_PASSWORD=<smtp-password>
APP_MAIL_FROM=noreply@yourdomain.com

# --- Application URLs ---
APP_BASE_URL=https://api.yourdomain.com
APP_CLIENT_BASE_URL=https://yourdomain.com

# --- OCI Container Registry (needed for `docker compose pull`) ---
OCI_REGION=ap-mumbai-1
OCI_TENANCY_NAMESPACE=<your-tenancy-namespace>
OCI_REPO_NAME=feature-flag
OCI_USERNAME=<tenancy-namespace>/<oci-username>
OCI_AUTH_TOKEN=<oci-auth-token>

# =============================================================================
# Production Environment Variables
# Copy this file to .env on the OCI VM at /opt/platform/.env
# Fill in all values — never commit the real .env to git!
# =============================================================================

# --- OCI Autonomous Database ---
# Connection string format for Autonomous DB:
#   jdbc:oracle:thin:@<db-name>_low?TNS_ADMIN=/opt/oracle/wallet
# Download the wallet from OCI Console > Autonomous Database > DB Connection
SPRING_DATASOURCE_URL=jdbc:oracle:thin:@featureflagdb_low?TNS_ADMIN=/opt/oracle/wallet
SPRING_DATASOURCE_USERNAME=ADMIN
SPRING_DATASOURCE_PASSWORD=<your-autonomous-db-password>

# --- JWT ---
# REQUIRED. There is no default anywhere: docker-compose refuses to start without it, and the application
# refuses to start outside dev/test/local without it. Generate a fresh one per environment and never reuse
# a value that has appeared in a repository, an example file or a guide — the app rejects the key this
# repository once shipped, in every profile.
# Generate with: openssl rand -base64 32
JWT_SECRET=<base64-encoded-256-bit-secret>

# --- Email (SMTP) ---
# Use a real SMTP provider (e.g., Brevo, SendGrid, AWS SES, Gmail SMTP)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=<smtp-username>
MAIL_PASSWORD=<smtp-password>
APP_MAIL_FROM=noreply@yourdomain.com

# --- Kafka (feature-change events) ---
# Optional. Set both to publish feature-change events. Comma-separated host:port list.
#
# Leaving them unset does NOT fail startup: publishing is disabled with a loud ERROR at boot and
# every skipped event is logged and counted. That is deliberate — this channel has no consumer yet,
# so a missing broker must not be able to take the whole API down with it. There is no localhost
# fallback in prod/staging either, so an unset value can never silently point the producer at itself.
KAFKA_BOOTSTRAP_SERVERS=broker-1.yourdomain.com:9092,broker-2.yourdomain.com:9092
KAFKA_SCHEMA_REGISTRY_URL=https://schema-registry.yourdomain.com
# PLAINTEXT | SSL | SASL_PLAINTEXT | SASL_SSL. Anything but PLAINTEXT also needs the
# matching SASL/SSL settings, supplied as e.g. SPRING_KAFKA_PROPERTIES_SASL_MECHANISM
# and SPRING_KAFKA_PROPERTIES_SASL_JAAS_CONFIG.
KAFKA_SECURITY_PROTOCOL=SASL_SSL
# Topic shape — see docs/feature-events.md (6 partitions, RF 3 in prod).
KAFKA_TOPIC_PARTITIONS=6
KAFKA_TOPIC_REPLICAS=3
# Set false when the topic is provisioned by infrastructure code / a platform team.
KAFKA_TOPIC_AUTO_PROVISION=true
# Timeouts (ms). Defaults shown; lower them further if the API must never wait on Kafka.
KAFKA_MAX_BLOCK_MS=5000
KAFKA_REQUEST_TIMEOUT_MS=5000
KAFKA_DELIVERY_TIMEOUT_MS=15000
KAFKA_SCHEMA_REGISTRY_CONNECT_TIMEOUT_MS=3000
KAFKA_SCHEMA_REGISTRY_READ_TIMEOUT_MS=5000

# --- Application URLs ---
APP_BASE_URL=https://api.yourdomain.com
APP_CLIENT_BASE_URL=https://yourdomain.com

# --- OCI Container Registry (needed for `docker compose pull`) ---
OCI_REGION=ap-mumbai-1
OCI_TENANCY_NAMESPACE=<your-tenancy-namespace>
OCI_REPO_NAME=feature-flag
OCI_USERNAME=<tenancy-namespace>/<oci-username>
OCI_AUTH_TOKEN=<oci-auth-token>
